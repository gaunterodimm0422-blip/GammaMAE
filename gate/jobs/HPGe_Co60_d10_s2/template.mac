# ---- GammaMAE v2 | HPGe | generated by make_package.py ----
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/gate/geometry/setMaterialDatabase @MATDB@
/gate/world/geometry/setXLength 120 cm
/gate/world/geometry/setYLength 120 cm
/gate/world/geometry/setZLength 120 cm
/gate/world/setMaterial G4_AIR
/gate/world/daughters/name   HPGe_crystal
/gate/world/daughters/insert cylinder
/gate/HPGe_crystal/geometry/setRmax   2.5 cm
/gate/HPGe_crystal/geometry/setHeight 5.0 cm
/gate/HPGe_crystal/placement/setTranslation 0 0 0 cm
/gate/HPGe_crystal/setMaterial Germanium
/gate/HPGe_crystal/attachCrystalSDnoSystem
/gate/physics/addPhysicsList emstandard_opt3
/gate/physics/Gamma/SetCutInRegion    world 1 mm
/gate/physics/Electron/SetCutInRegion world 1 mm
/gate/physics/Gamma/SetCutInRegion    HPGe_crystal 0.1 mm
/gate/physics/Electron/SetCutInRegion HPGe_crystal 0.1 mm
/gate/output/root/enable
/gate/output/root/setFileName        @OUTNAME@
/gate/output/root/setRootHitFlag     1
/gate/output/root/setRootSinglesFlag 0
/gate/output/root/setRootNtupleFlag  0
/gate/random/setEngineName MersenneTwister
/gate/random/setEngineSeed @SEED@
/gate/run/initialize
/gate/source/addSource L00
/gate/source/L00/gps/particle   gamma
/gate/source/L00/gps/energytype Mono
/gate/source/L00/gps/monoenergy 1.1732280 MeV
/gate/source/L00/gps/type       Point
/gate/source/L00/gps/centre     0 0 12.5000 cm
/gate/source/L00/gps/direction  0 0 -1
/gate/source/L00/setActivity    718.808 Bq
/gate/source/L00/gps/angtype    iso
/gate/source/L00/gps/mintheta   0 deg
/gate/source/L00/gps/maxtheta   16.0362 deg
/gate/source/addSource L01
/gate/source/L01/gps/particle   gamma
/gate/source/L01/gps/energytype Mono
/gate/source/L01/gps/monoenergy 1.3324920 MeV
/gate/source/L01/gps/type       Point
/gate/source/L01/gps/centre     0 0 12.5000 cm
/gate/source/L01/gps/direction  0 0 -1
/gate/source/L01/setActivity    719.763 Bq
/gate/source/L01/gps/angtype    iso
/gate/source/L01/gps/mintheta   0 deg
/gate/source/L01/gps/maxtheta   16.0362 deg
/gate/application/setTimeSlice @TSLICE@ s
/gate/application/setTimeStart @TSTART@ s
/gate/application/setTimeStop  @TSTOP@ s
/gate/application/startDAQ
